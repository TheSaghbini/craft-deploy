{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "vectorcraft/Dockerfile",
    "watchPatterns": [
      "/vectorcraft/**",
      "/nginx/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 30
  }
}
